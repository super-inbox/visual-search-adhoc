 "deviations_from_upstream_train_py": [
  "num_train_epochs 1 -> up to 30 (the variable under test); linear warmup 0.1 + decay is computed by HF over the full 30-epoch step count, so epoch 1 here is still in warmup and is NOT equivalent to the old 1-epoch run (whose lr decayed to 0 within 344 steps)",
  "save_total_limit 3 -> None: keep every epoch checkpoint so each table row has a checkpoint (~420 MB each); selection is still by eval_loss via load_best_model_at_end",
  "set_seed(seed) before model construction: upstream builds the model before the Trainer seeds, so the old run's initial weights are unseeded and cannot be reproduced",
  "train/val IDs are pinned to holdout_split.json (re-derived with upstream split_by_signer and asserted identical) instead of trusting a fresh split",
  "compute_metrics extended with chrF/CER, full-reference scoring and per-sample files; the upstream truncated-label BLEU/WER are kept as legacy_* for comparison",
  "report_to none (metrics are written to JSON/CSV instead of TensorBoard)",
  "per-epoch greedy generation on the 147 frozen examples (diagnostic only)"
 ],
 "p013_deviations_from_train_p02": [
  "input representation: 501-d MediaPipe landmarks -> 768-d frozen Uni-Sign mT5-encoder features (the variable under test); Conformer projection Linear(501,512) -> Linear(768,512)",
